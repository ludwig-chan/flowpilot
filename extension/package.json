{
  "name": "flowpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite build --watch & vite build --watch --config vite.content.config.ts",
    "build": "vite build && vite build --config vite.content.config.ts",
    "zip": "powershell -Command \"Compress-Archive -Force -Path dist -DestinationPath flowpilot.zip\"",
    "deploy": "powershell -Command \"Remove-Item -Recurse -Force '../client/resources/extension/*' -ErrorAction SilentlyContinue; Copy-Item -Force -Recurse -Path dist\\* -Destination '../client/resources/extension'\"",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@vitejs/plugin-vue": "^5.2.0",
    "sass": "^1.80.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
